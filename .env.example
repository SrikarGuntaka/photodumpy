# Copy to .env and adjust. `docker compose` reads .env automatically.

# ---------------------------------------------------------------------------
# The host directory containing your photos. It is mounted READ-ONLY into the
# api and worker containers at /photos. The application can never read anything
# outside it, and can never write to it at all.
#
# Windows example:  HOST_PHOTOS_DIR=C:/Users/you/Pictures
# macOS/Linux:      HOST_PHOTOS_DIR=/home/you/Pictures
# ---------------------------------------------------------------------------
HOST_PHOTOS_DIR=./sample-photos

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=photo
POSTGRES_PASSWORD=photo
POSTGRES_DB=photoorganizer
# Host port. Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
API_PORT=8080
ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Detection thresholds
#
# Every value here is a judgement call, not a constant of nature. Leave them
# unset to use the calibrated defaults; DESIGN_DECISIONS.md records how each
# default was measured and why it should be re-checked against a real library.
# ---------------------------------------------------------------------------

# Hamming distance (out of 64) below which two photos count as near-duplicates.
# Default 12. Raising it groups more aggressively; above 24 it stops meaning
# anything, because unrelated hashes differ by about 32 bits.
#SIMILARITY_THRESHOLD=12

# Silence between consecutive photos that ends an event. Go duration syntax.
# Default 4h.
#CLUSTER_MAX_GAP=4h

# How far a photo may sit from its event's first GPS fix before it starts a new
# event. Default 1500 (metres) -- roughly a fifteen-minute walk.
#CLUSTER_MAX_RADIUS_METERS=1500
